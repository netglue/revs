{
    "name": "netglue/revs",
    "description": "Simple utility for revving file name versions and deleting old revisions",
    "type": "library",
    "license": "MIT",
    "authors" : [
        {
            "name" : "George Steel",
            "email" : "george@net-glue.co.uk",
            "homepage" : "https://netglue.uk/"
        }
    ],
    "config" : {
        "minimum-stability" : "stable",
        "prefer-stable" : true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "bin": [
        "bin/rev"
    ],
    "require": {
        "php": "~8.3 || ~8.4 || ~8.5",
        "ramsey/uuid": "^4.7.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0.0",
        "phpunit/phpunit": "^12.5.14 || ^13",
        "psalm/plugin-phpunit": "^0.19.5",
        "squizlabs/php_codesniffer": "^4.0.1",
        "vimeo/psalm": "^6.15.1"
    },
    "conflict": {
        "symfony/string": "<6.4.15 || <7.2.0"
    },
    "autoload": {
        "psr-4": {
            "Netglue\\Revs\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netglue\\RevsTest\\" : "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover build/clover.xml",
        "static-analysis": "psalm --shepherd --stats",
        "update-baseline": "psalm --update-baseline"
    }
}
